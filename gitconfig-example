[color]
	ui = auto

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	# E-ink theme. No "syntax" keyword anywhere → stays grayscale (no code colors).
	# Delta pads lines to full width, so background blocks fill cleanly (no tab gaps).
	navigate    = true          # n / N to jump between files
	line-numbers = true
	hyperlinks  = false
	tabs        = 4
	keep-plus-minus-markers = true   # keep literal +/- at line start as an explicit cue

	# ── file header → bold white text, underlined, with the path shown once
	file-style            = bold white
	file-decoration-style = white ul
	# delta shows old/new paths in its file header; color them by side:
	file-added-label      = [+]
	file-removed-label    = [-]
	file-modified-label   = [~]

	# ── hunk header (@@ … @@ + function context) → bold yellow, boxed to set it apart
	hunk-header-style            = yellow bold
	hunk-header-decoration-style = yellow box
	hunk-header-file-style       = white bold
	hunk-header-line-number-style = yellow bold

	# Both change types use LIGHT blocks (dark grays are invisible on e-ink — they
	# read as the black terminal bg). Distinguished by DIFFERENT light shades + bold.
	# ── ADDED lines → bold black on LIGHTEST block (#e4e4e4 = 254)
	plus-style      = bold black 254
	# changed WORDS within an added line → bold black on a darker patch (pops out)
	plus-emph-style = bold black 250
	# ── REMOVED lines → black on a MEDIUM-light block (#a8a8a8 = 248), normal weight
	minus-style      = black 248
	# changed WORDS within a removed line → bold black on lighter patch
	minus-emph-style = bold black 254
	# ── context (unchanged) lines → plain white text on black (no block, recedes)
	zero-style = white

	# ── line-number gutter (avoid dim grays 240/245 — invisible on e-ink; use 250+)
	line-numbers-left-style  = 250
	line-numbers-right-style = 250
	line-numbers-minus-style = 250
	line-numbers-plus-style  = white
	line-numbers-zero-style  = 250
	line-numbers-left-format  = "{nm:>4}┊"
	line-numbers-right-format = "{np:>4}│"

[color "diff"]
	# Each element a DISTINCT style. Underline DOES render on this terminal.
	# file header (diff --git, index, ---, +++)  → bold white + UNDERLINE
	meta       = white bold ul
	# @@ hunk position                           → bold YELLOW + underline (different hue)
	frag       = yellow bold ul
	# function name shown after @@ context        → plain yellow (subtle context)
	func       = yellow
	# commit header in git show                  → bold white + underline (like meta)
	commit     = white bold ul
	# ADDED lines   → bold bright WHITE, no underline, no block (clean, no tab gaps)
	new        = 231 bold
	# REMOVED lines → black text on light-gray block (#e4e4e4) — the only other
	# distinct, always-visible style. Leading tabs gap, but it reads clearly.
	old        = black 254
	# trailing whitespace                        → reverse so it's caught
	whitespace = reverse

[color "status"]
	# staged (ready to commit)                   → bold white (most important)
	added      = bold white
	# modified but not staged                    → bold yellow (needs attention)
	changed    = bold yellow
	# untracked / deleted                        → white (exists but lower priority)
	untracked  = white
	deleted    = white
	# branch name line                           → gray block
	branch     = bold black 254

[color "branch"]
	# current branch                             → gray block (same as PS1 path)
	current  = bold black 254
	# local branches                             → bold white
	local    = bold white
	# remote branches                            → bold yellow (different tier)
	remote   = bold yellow
	upstream = yellow

[color "decorate"]
	# HEAD pointer                               → gray block (highest priority)
	HEAD         = bold black 254
	# local branches                             → bold white
	branch       = bold white
	# remote branches                            → bold yellow
	remoteBranch = bold yellow
	# tags                                       → yellow italic (distinct from branches)
	tag          = italic yellow
	stash        = white
	grafted      = bold white

[color "grep"]
	filename   = bold yellow
	linenumber = white
	match      = bold black 254
	separator  = white

[alias]
	# e-ink log: gray block for hash, yellow for decorations, hierarchy by weight
	lg = log --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) %C(white)<%an>%Creset'
	# same but with full date and graph
	lgg = log --graph --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) <%an>%Creset'
	# OLD pre-delta diff (uses [color "diff"] styling + less, bypasses delta)
	rawdiff = -c core.pager='less -R' diff
	rawshow = -c core.pager='less -R' show
