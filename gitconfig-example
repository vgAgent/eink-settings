[color]
	ui = auto

[color "diff"]
	# file header (diff --git, index, ---, +++)  → gray block banner (#e4e4e4, no tab gaps
	# here since these lines start at col 0). Strong file-boundary marker.
	meta       = black 254
	# @@ hunk position                           → bold bright white (yellow was too weak,
	# cyan looked like white; @@ lines also start at col 0 so no gaps if blocked later)
	frag       = 231 bold
	# function name shown after @@ context        → bold white
	func       = 231 bold
	# commit header in git show                  → bold bright white
	commit     = 231 bold
	# ADDED lines   → bold bright WHITE text on black — clean, no bg, no tab gaps
	new        = 231 bold
	# REMOVED lines → black text on light-gray block (#e4e4e4 = same as PS1 path)
	# Only a bg block stays visible AND distinct: dim grays vanish, hues≈white,
	# underline/strike don't render. Leading tabs gap, but the block reads clearly.
	old        = black 254
	# trailing whitespace                        → reverse so it's caught
	whitespace = reverse

[color "status"]
	# staged (ready to commit)                   → bold white (most important)
	added      = bold white
	# modified but not staged                    → bold yellow (needs attention)
	changed    = bold yellow
	# untracked / deleted                        → white (exists but lower priority)
	untracked  = white
	deleted    = white
	# branch name line                           → gray block
	branch     = bold black 254

[color "branch"]
	# current branch                             → gray block (same as PS1 path)
	current  = bold black 254
	# local branches                             → bold white
	local    = bold white
	# remote branches                            → bold yellow (different tier)
	remote   = bold yellow
	upstream = yellow

[color "decorate"]
	# HEAD pointer                               → gray block (highest priority)
	HEAD         = bold black 254
	# local branches                             → bold white
	branch       = bold white
	# remote branches                            → bold yellow
	remoteBranch = bold yellow
	# tags                                       → yellow italic (distinct from branches)
	tag          = italic yellow
	stash        = white
	grafted      = bold white

[color "grep"]
	filename   = bold yellow
	linenumber = white
	match      = bold black 254
	separator  = white

[alias]
	# e-ink log: gray block for hash, yellow for decorations, hierarchy by weight
	lg = log --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) %C(white)<%an>%Creset'
	# same but with full date and graph
	lgg = log --graph --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) <%an>%Creset'
