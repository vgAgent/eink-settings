syntax on
filetype plugin indent on

" true colors in tmux/SSH — must come before colorscheme
if has('termguicolors')
  let &t_8f = "\<Esc>[38;2;%lu;%lu;%lum"
  let &t_8b = "\<Esc>[48;2;%lu;%lu;%lum"
  set termguicolors
endif

colorscheme morning-eink

" :T to cycle themes — works in any SSH/tmux environment
command! T call CycleEinkTheme()
function! CycleEinkTheme()
  if g:colors_name == 'morning-eink'
    colorscheme eink-light
  elseif g:colors_name == 'eink-light'
    colorscheme eink-dark
  else
    colorscheme morning-eink
  endif
  echo g:colors_name
endfunction
