[color]
	ui = auto

[color "diff"]
	# Each element a DISTINCT style. Underline DOES render on this terminal.
	# file header (diff --git, index, ---, +++)  → bold white + UNDERLINE
	meta       = white bold ul
	# @@ hunk position                           → bold YELLOW + underline (different hue)
	frag       = yellow bold ul
	# function name shown after @@ context        → plain yellow (subtle context)
	func       = yellow
	# commit header in git show                  → bold white + underline (like meta)
	commit     = white bold ul
	# ADDED lines   → bold bright WHITE, no underline, no block (clean, no tab gaps)
	new        = 231 bold
	# REMOVED lines → black text on light-gray block (#e4e4e4) — the only other
	# distinct, always-visible style. Leading tabs gap, but it reads clearly.
	old        = black 254
	# trailing whitespace                        → reverse so it's caught
	whitespace = reverse

[color "status"]
	# staged (ready to commit)                   → bold white (most important)
	added      = bold white
	# modified but not staged                    → bold yellow (needs attention)
	changed    = bold yellow
	# untracked / deleted                        → white (exists but lower priority)
	untracked  = white
	deleted    = white
	# branch name line                           → gray block
	branch     = bold black 254

[color "branch"]
	# current branch                             → gray block (same as PS1 path)
	current  = bold black 254
	# local branches                             → bold white
	local    = bold white
	# remote branches                            → bold yellow (different tier)
	remote   = bold yellow
	upstream = yellow

[color "decorate"]
	# HEAD pointer                               → gray block (highest priority)
	HEAD         = bold black 254
	# local branches                             → bold white
	branch       = bold white
	# remote branches                            → bold yellow
	remoteBranch = bold yellow
	# tags                                       → yellow italic (distinct from branches)
	tag          = italic yellow
	stash        = white
	grafted      = bold white

[color "grep"]
	filename   = bold yellow
	linenumber = white
	match      = bold black 254
	separator  = white

[alias]
	# e-ink log: gray block for hash, yellow for decorations, hierarchy by weight
	lg = log --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) %C(white)<%an>%Creset'
	# same but with full date and graph
	lgg = log --graph --pretty=format:'%C(bold white)%h%Creset %C(bold yellow)%d%Creset %s %C(white)(%cr) <%an>%Creset'
